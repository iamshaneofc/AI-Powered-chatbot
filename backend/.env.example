# ===========================================================================
# .env.example — Copy this to .env and fill in your values.
# NEVER commit the real .env file to version control.
# ===========================================================================

# ── App ───────────────────────────────────────────────────────────────────
APP_NAME="AI Q&A Backend"
APP_VERSION="1.0.0"
ENVIRONMENT="development"        # development | staging | production
DEBUG=true

# ── Server ────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── Logging ───────────────────────────────────────────────────────────────
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR

# ── CORS — comma-separated list of allowed origins ────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── OpenAI ───────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...            # Required — get from https://platform.openai.com
OPENAI_MODEL=gpt-4o              # gpt-4o | gpt-4o-mini | gpt-3.5-turbo
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_MAX_TOKENS=1024
OPENAI_TEMPERATURE=0.2

# ── Whisper ───────────────────────────────────────────────────────────────
WHISPER_MODEL=base               # tiny | base | small | medium | large
                                 # larger = slower but more accurate

# ── FAISS Vector Store ────────────────────────────────────────────────────
FAISS_INDEX_PATH=app/vectorstore/index
VECTOR_CHUNK_SIZE=512            # Characters per chunk
VECTOR_CHUNK_OVERLAP=64          # Overlap between consecutive chunks
VECTOR_TOP_K=5                   # Number of chunks to retrieve per query

# ── File Upload ───────────────────────────────────────────────────────────
UPLOAD_DIR=app/uploads
MAX_UPLOAD_SIZE_MB=50
ALLOWED_EXTENSIONS=pdf,txt,docx,mp3,mp4,wav,m4a,webm,png,jpg,jpeg
